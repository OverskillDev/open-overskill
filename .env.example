# Open Overskill reference. Never commit real credentials or customer data.
# Demo stays enabled even if a partner key is present. No provider calls or fees.
OVERSKILL_MOCK=1
OVERSKILL_LIVE_ENABLED=0
OVERSKILL_API_BASE=https://www.overskill.com
OVERSKILL_PARTNER_SLUG=open-overskill
OVERSKILL_PARTNER_NAME=Your builder
OVERSKILL_PARTNER_API_KEY=
OVERSKILL_PARTNER_EMBED_ORIGINS=

# Primary customer flow: http://127.0.0.1:3577/workspace
# Use the exact browser origin, including its port. localhost is a different origin.
OPEN_OVERSKILL_ORIGIN=http://127.0.0.1:3577
OPEN_OVERSKILL_HOSTED=0
# Customer metadata and encrypted credentials require persistent private disk.
# Defaults to .data in this project. An override must be an absolute path.
# OPEN_OVERSKILL_DATA_DIR=/absolute/private/persistent-directory

# Live customer identity; never use NEXT_PUBLIC_ for any of these values.
# Configure your OIDC provider separately and register:
# https://your-builder.example/api/customer/callback
OPEN_OVERSKILL_OIDC_ISSUER=
OPEN_OVERSKILL_OIDC_CLIENT_ID=
OPEN_OVERSKILL_OIDC_CLIENT_SECRET=
# Exactly 32 securely generated random bytes encoded as base64. Keep stable.
# Required for live storage; back it up separately from the database.
# Demo creates its own private local key. Do not copy that key into live mode.
OPEN_OVERSKILL_ENCRYPTION_KEY=

# Shared live API adapter requires this server-only token (32+ characters).
# setup generates one locally. It is NOT a customer sign-in credential.
OPEN_OVERSKILL_OPERATOR_TOKEN=

# Original /builder operator sandbox only:
OPEN_OVERSKILL_CREATOR_EMAIL=
# Durable internal creator ID, not an email or a freshly generated value.
# /workspace derives an immutable ID per authenticated customer instead.
OVERSKILL_CREATOR_ID=

# Deliberate live setup also requires approved partner access and backend support:
# OVERSKILL_MOCK=0
# OVERSKILL_LIVE_ENABLED=1
# For hosted CUSTOMER routes, set the exact HTTPS origin and opt in explicitly:
# OPEN_OVERSKILL_ORIGIN=https://your-builder.example
# OPEN_OVERSKILL_HOSTED=1
# The /builder operator sandbox remains local-only.
#
# Read README.md and CUSTOMER_AUTH.md before enabling real customer operations.
# Stable creator provisioning and usage reporting require compatible core APIs.
# Exact deployment-status support must be verified before publication is enabled.
# Existing packs and checkout require the creator-credit-packs-v1 core capability.
# Checkout stays unavailable until that backend contract and rollout are enabled.
# Live provisioning can trigger existing core account-setup jobs; generation uses
# the customer's workspace credits and existing billing/auto-top-up policy.
# Incoming webhooks are disabled. A provider timeout is not permission to retry.
